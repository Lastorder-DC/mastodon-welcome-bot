# 마스토돈 서버 도메인 (예: mastodon.social)
MASTODON_DOMAIN=mastodon.example.com

# 마스토돈 OAuth 액세스 토큰 (write:statuses 권한 필요)
MASTODON_ACCESS_TOKEN=your_access_token_here

# 웹훅 시크릿 (마스토돈 관리자 패널에서 설정한 값과 동일해야 함)
WEBHOOK_SECRET=your_webhook_secret_here

# 서버 포트 (기본값: 3000)
PORT=3000

# 환영 메시지 템플릿
# 사용 가능한 변수:
#   {{username}}     - 사용자 이름 (예: alice)
#   {{display_name}} - 표시 이름 (예: Alice Kim)
#   {{domain}}       - 서버 도메인 (예: mastodon.example.com)
#   {{url}}          - 사용자 프로필 URL (예: https://mastodon.example.com/@alice)
WELCOME_MESSAGE=안녕하세요 {{display_name}}님! {{domain}}에 오신 것을 환영합니다 🎉\n\n계정이 승인되었습니다. 이제 자유롭게 글을 작성하고 다른 사람들과 소통할 수 있습니다.\n\n궁금한 점이 있으면 언제든지 이 계정으로 DM을 보내주세요!
